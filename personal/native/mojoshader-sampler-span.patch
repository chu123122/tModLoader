+/* The ShaderCross D3D12 convenience path reflects again, discarding supplied
+ * counts. Create the DXIL shader directly so XNA's sparse sampler slots survive. */
+static SDL_GPUShader *create_cross_shader_with_register_span(
+    SDL_GPUDevice *device, const SDL_ShaderCross_SPIRV_Info *info,
+    SDL_ShaderCross_GraphicsShaderMetadata *metadata, Uint32 samplerSlots)
+{
+    if (metadata == NULL)
+        return NULL;
+
+    metadata->resource_info.num_samplers = SDL_max(metadata->resource_info.num_samplers, samplerSlots);
+    if ((SDL_GetGPUShaderFormats(device) & SDL_GPU_SHADERFORMAT_DXIL) && SDL_ShaderCross_CompileDXILFromSPIRV != NULL)
+    {
+        size_t size = 0;
+        void *dxil = SDL_ShaderCross_CompileDXILFromSPIRV(info, &size);
+        SDL_GPUShaderCreateInfo createInfo;
+        SDL_GPUShader *shader;
+        if (dxil == NULL)
+            return NULL;
+
+        SDL_zero(createInfo);
+        createInfo.code = (const Uint8 *) dxil;
+        createInfo.code_size = size;
+        createInfo.entrypoint = info->entrypoint;
+        createInfo.format = SDL_GPU_SHADERFORMAT_DXIL;
+        createInfo.stage = (SDL_GPUShaderStage) info->shader_stage;
+        createInfo.num_samplers = metadata->resource_info.num_samplers;
+        createInfo.num_storage_textures = metadata->resource_info.num_storage_textures;
+        createInfo.num_storage_buffers = metadata->resource_info.num_storage_buffers;
+        createInfo.num_uniform_buffers = metadata->resource_info.num_uniform_buffers;
+        shader = SDL_CreateGPUShader(device, &createInfo);
+        SDL_free(dxil);
+        return shader;
+    }
+    return SDL_ShaderCross_CompileGraphicsShaderFromSPIRV(device, info, metadata, 0);
+}
+
