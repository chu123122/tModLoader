+	private static HashSet<Item> GetNativeMaterialReferences(List<Chest> chests)
+	{
+		var seen = new HashSet<Item>(Main.LocalPlayer.inventory.Take(58), ReferenceEqualityComparer.Instance);
+		foreach (var chest in chests)
+			seen.UnionWith(chest.item.Take(chest.maxItems));
+		return seen;
+	}
+
+	private static int CountModdedMaterials(Recipe.RequiredItemEntry req, List<Chest> chests)
+	{
+		int count = 0;
+		var seen = GetNativeMaterialReferences(chests);
+		foreach (var (items, _) in PlayerLoader.GetModdedCraftingMaterials(Main.LocalPlayer))
+			foreach (var item in items)
+				if (seen.Add(item) && req.Matches(item.type))
+					count += item.stack;
+		return count;
+	}
+
+	private static void ConsumeModdedMaterials(Recipe.RequiredItemEntry req, List<Chest> chests, ref int remaining, List<Item> consumedItems)
+	{
+		var seen = GetNativeMaterialReferences(chests);
+		foreach (var (items, callback) in PlayerLoader.GetModdedCraftingMaterials(Main.LocalPlayer)) {
+			int index = -1;
+			foreach (var item in items) {
+				index++;
+				if (!seen.Add(item) || item.IsAir || !req.Matches(item.type))
+					continue;
+				int amount = System.Math.Min(item.stack, remaining);
+				var consumed = item.Clone();
+				consumed.stack = amount;
+				item.stack -= amount;
+				if (item.stack <= 0)
+					item.TurnToAir();
+				callback?.Invoke(item, index);
+				consumedItems?.Add(consumed);
+				remaining -= amount;
+				if (remaining <= 0)
+					return;
+			}
+		}
+	}
